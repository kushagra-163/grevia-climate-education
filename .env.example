# Grevia Environment Configuration

NODE_ENV=development
PORT=3001
AI_PORT=3002
MONGO_URI=mongodb://localhost:27017/grevia
REDIS_URL=redis://localhost:6379

JWT_ACCESS_SECRET=grevia_super_secret_access_key_2026_change_in_prod
JWT_REFRESH_SECRET=grevia_super_secret_refresh_key_2026_change_in_prod

AI_SERVICE_URL=http://localhost:3002
